          "legendFormat": "non_heap_used_memory {{instance}}",
          "refId": "non_heap_used_memory {{instance}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kronotop_non_heap_committed_memory_bytes{kronotop_cluster_name=\"$cluster\", instance=~\"$instance\"}",
          "legendFormat": "non_heap_committed_memory {{instance}}",
          "refId": "non_heap_committed_memory {{instance}}"
