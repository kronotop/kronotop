{
  "uid": "kronotop-jvm",
  "title": "Kronotop JVM",
  "tags": [
    "kronotop"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(kronotop_uptime_in_seconds, kronotop_cluster_name)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {}
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(kronotop_uptime_in_seconds{kronotop_cluster_name=\"$cluster\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Heap",
      "collapsed": false,
      "gridPos": {
        "w": 24,
        "h": 1,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Heap",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kronotop_heap_used_memory_bytes{kronotop_cluster_name=\"$cluster\", instance=~\"$instance\"}",
          "legendFormat": "heap_used_memory {{instance}}",
          "refId": "heap_used_memory {{instance}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kronotop_heap_committed_memory_bytes{kronotop_cluster_name=\"$cluster\", instance=~\"$instance\"}",
          "legendFormat": "heap_committed_memory {{instance}}",
          "refId": "heap_committed_memory {{instance}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "kronotop_heap_max_memory_bytes{kronotop_cluster_name=\"$cluster\", instance=~\"$instance\"}",
          "legendFormat": "heap_max_memory {{instance}}",
          "refId": "heap_max_memory {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 1
      },
      "id": 2
    },
    {
      "type": "timeseries",
