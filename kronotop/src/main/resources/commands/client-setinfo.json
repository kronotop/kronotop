          {
            "name": "lib-name",
            "type": "pure-token",
            "token": "lib-name",
            "summary": "Name of the client library."
          },
          {
            "name": "lib-ver",
            "type": "pure-token",
            "token": "lib-ver",
            "summary": "Version of the client library."
