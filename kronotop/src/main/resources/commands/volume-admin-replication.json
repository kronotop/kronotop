{
  "REPLICATION": {
    "summary": "Starts or stops volume replication on a standby member.",
    "complexity": "O(1)",
    "group": "volume",
    "since": "2026.06-1",
    "arity": 4,
    "container": "VOLUME.ADMIN",
    "command_flags": [
      "ADMIN",
      "WRITE"
    ],
    "acl_categories": [
      "ADMIN",
      "VOLUME"
    ],
    "key_specs": [],
    "reply_schema": {
      "const": "OK"
    },
    "arguments": [
      {
        "name": "operation",
        "type": "oneof",
        "summary": "Whether to start or stop replication. Case-insensitive.",
        "arguments": [
          {
            "name": "start",
            "type": "pure-token",
            "token": "START"
          },
          {
            "name": "stop",
            "type": "pure-token",
            "token": "STOP"
          }
        ]
      },
      {
        "name": "volume-name",
        "type": "string",
        "summary": "The name of the volume, in the format <kind>-shard-<id>."
      }
    ]
  }
}
